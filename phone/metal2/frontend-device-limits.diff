+// SweetMetal2: _MTLDevice keeps a `_limits` struct (maxTextureWidth2D, maxColorAttachments, ... maxBufferLength) that its `limits` SPI
+// returns and Metal and its clients read directly. initLimits fills it from an Apple GPU profile and is empty here, so every field stayed 0:
+// Photos fits each image into limits->maxTextureWidth2D x maxTextureHeight2D and aborted on a 0x0 context (PXGMetalTextureConverter,
+// "!PXPixelSizeAreaIsZero(roundedSize)"). The struct's field names are in the ivar's type encoding; each field gets this device's own
+// answer to the selector of the same name (installAnswers, or a method of NBDeviceMethods), and a field nothing answers stays 0.
+static void fillLimits(id device) {
+ Ivar ivar=class_getInstanceVariable(object_getClass(device),"_limits");
+ const char *type=ivar?ivar_getTypeEncoding(ivar):nullptr;
+ if(!type||*type!='{'){NBLOG(@"native-metal: no _limits ivar");return;}
+ const char *p=strchr(type,'=');if(!p){NBLOG(@"native-metal: _limits encoding %s",type);return;}
+ p++;
+ uint8_t *base=(uint8_t *)(__bridge void *)device+ivar_getOffset(ivar);
+ size_t offset=0;unsigned filled=0,fields=0;
+ while(*p=='"') {
+  const char *end=strchr(p+1,'"');if(!end)break;
+  std::string name(p+1,end-p-1);char code=end[1];p=end+2;
+  size_t size=code=='Q'||code=='q'?8:code=='I'||code=='i'||code=='f'?4:0;
+  if(!size){NBLOG(@"native-metal: _limits field %s type %c not handled",name.c_str(),code);return;}
+  offset=(offset+size-1)&~(size-1);fields++;
+  SEL sel=sel_registerName(name.c_str());uint64_t value=0;bool have=false;
+  auto answer=gAnswers.find(sel);
+  if(answer!=gAnswers.end()){value=answer->second;have=true;}
+  else if(Method m=class_getInstanceMethod([NBDeviceMethods class],sel)) {
+   char ret[8]={};method_getReturnType(m,ret,sizeof ret);
+   if(method_getNumberOfArguments(m)==2&&(ret[0]=='Q'||ret[0]=='I')){value=((uint64_t(*)(id,SEL))objc_msgSend)(device,sel);have=true;}
+  }
+  if(have&&value) {
