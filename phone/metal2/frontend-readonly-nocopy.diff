+// Every page of [p, p+n) is mapped without write permission in this process.
+static bool readOnlyRange(const void *p,size_t n) {
+ vm_address_t at=(vm_address_t)(uintptr_t)p;const vm_address_t end=at+n;
+ while(at<end) {
+  vm_address_t addr=at;vm_size_t size=0;vm_region_basic_info_data_64_t info;
+  mach_msg_type_number_t count=VM_REGION_BASIC_INFO_COUNT_64;mach_port_t object=MACH_PORT_NULL;
+  if(vm_region_64(mach_task_self(),&addr,&size,VM_REGION_BASIC_INFO_64,(vm_region_info_t)&info,&count,&object)!=KERN_SUCCESS)return false;
+  if(addr>at || (info.protection&VM_PROT_WRITE))return false;
+  at=addr+size;
+ }
+ return true;
+}
