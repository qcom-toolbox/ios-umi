+  NmbCommandBuffer *handle=_handle;
   if(nmb_command_buffer_on_completed(_handle,completed,context) &&
-     nmb_command_buffer_on_scheduled(_handle,scheduled,context) && nmb_command_buffer_commit(_handle))return;
+     nmb_command_buffer_on_scheduled(_handle,scheduled,context) && nmb_command_buffer_commit(_handle)) {
+   if(syncMs) {
+    const uint64_t n=++gSurfaceSyncs;
+    if(nmb_command_buffer_wait(handle,syncMs)!=0 && gSurfaceSyncTimeouts++<16)
+     NBLOG(@"native-metal: surface sync: GPU not done after %u ms (commit %llu)",syncMs,(unsigned long long)n);
+    if((n&1023)==0){char line[128];snprintf(line,sizeof line,"native-metal: surface sync: %llu commits waited, %llu over the cap",
+     (unsigned long long)n,(unsigned long long)gSurfaceSyncTimeouts.load());sm2_logs(line);}
+   }
+   return;
