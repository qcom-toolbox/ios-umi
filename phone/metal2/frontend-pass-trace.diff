+  case 'd':{double x;[inv getReturnValue:&x];v=x;break;}
+  case 'f':{float x;[inv getReturnValue:&x];v=x;break;}
+  case 'Q':case 'L':{unsigned long long x;[inv getReturnValue:&x];v=(double)x;break;}
+  case 'q':case 'l':{long long x;[inv getReturnValue:&x];v=(double)x;break;}
+  case 'I':{unsigned x;[inv getReturnValue:&x];v=x;break;}
+  case 'i':{int x;[inv getReturnValue:&x];v=x;break;}
+  case 'B':case 'c':case 'C':{unsigned char x;[inv getReturnValue:&x];v=x;break;}
