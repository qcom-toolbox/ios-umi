+// ---- pass trace (the App Library backdrop): on while /var/local/mtl2-trace-on exists, lines into /var/local/mtl2-trace.log ----
+// Small render targets (under 1.5 M pixels: the blur chain) are traced in full; in bigger passes only the draws that sample one of
+// the last small targets (the composite). Numbers only, no pixel readback.
+static std::mutex gTrLock;
+static std::string gTrText;
+static uint64_t gTrChecked,gTrBytes;
+static bool gTrState;
+static std::atomic<unsigned> gTrPass{0};
+static void *gTrSmall[64];
+static unsigned gTrSmallNext;
+static bool trOn() {
+ const uint64_t now=nowUs();
+ std::lock_guard<std::mutex> lock(gTrLock);
+ if(now-gTrChecked>200000) {
+  gTrChecked=now;
+  const bool on=access("/var/local/mtl2-trace-on",F_OK)==0;
+  if(on && !gTrState)gTrBytes=0;
+  gTrState=on;
+ }
+ return gTrState && gTrBytes<30000000;
+}
+static void trFlushLocked() {
+ if(gTrText.empty())return;
+ // opened per flush: the file can be emptied (removed and made again) between two captures
+ const int fd=open("/var/local/mtl2-trace.log",O_WRONLY|O_APPEND);
+ if(fd>=0){(void)write(fd,gTrText.data(),gTrText.size());close(fd);}
+ gTrBytes+=gTrText.size();gTrText.clear();
+}
+static void trLine(const char *fmt,...) __attribute__((format(printf,1,2)));
+static void trLine(const char *fmt,...) {
+ char buf[900];va_list ap;va_start(ap,fmt);int n=vsnprintf(buf,sizeof(buf)-1,fmt,ap);va_end(ap);
+ if(n<0)return;
+ if(n>(int)sizeof(buf)-2)n=(int)sizeof(buf)-2;
+ buf[n++]='\n';
+ std::lock_guard<std::mutex> lock(gTrLock);
+ gTrText.append(buf,(size_t)n);
+ if(gTrText.size()>32768)trFlushLocked();
+}
+static void trFlush() {std::lock_guard<std::mutex> lock(gTrLock);trFlushLocked();}
+static bool trIsSmall(void *t) {
+ if(!t)return false;
+ std::lock_guard<std::mutex> lock(gTrLock);
+ for(void *x:gTrSmall)if(x==t)return true;
+ return false;
+}
+static void trNoteSmall(void *t) {
+ std::lock_guard<std::mutex> lock(gTrLock);
+ for(void *x:gTrSmall)if(x==t)return;
+ gTrSmall[gTrSmallNext++%64]=t;
+}
