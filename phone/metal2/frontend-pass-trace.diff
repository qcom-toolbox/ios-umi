+struct TrProbe {Class cls;SEL sel;IMP orig;Method m;char type;uint64_t calls;double last,minv,maxv;uint64_t changes;};
+static std::mutex gPrLock;
+static std::vector<TrProbe> gPr;
+static std::unordered_map<std::string,uint64_t> gPrAsked;
+static TrProbe *prFind(Class c,SEL sel) {
