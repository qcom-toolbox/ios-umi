 		return;
@@ -724,36 +768,62 @@ wmi_mgmt_rx(const uint8_t *hdr, const uint8_t *m, uint32_t len)
 	 */
 	const uint8_t *bssid = f + 16;
 	uint64_t now = wlce_now_ms();
