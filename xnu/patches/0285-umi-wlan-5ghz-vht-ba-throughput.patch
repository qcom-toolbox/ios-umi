+/*
+ * umi 0285: the throughput meter. Each second the bytes in and out are counted; a second with more than
+ * 1 Mbit/s in either direction starts (or continues) a burst, and 3 quiet seconds end it with one line:
+ * how long, the mean and the best second each way. A speed test or a big download leaves its numbers in
+ * the log without a tool on the phone (boot-arg sweetnetmeter=0: off).
+ */
+static struct {
+	uint64_t at, in, out;                   /* start of the current second (ns), bytes then */
+	uint64_t burst_in, burst_out;           /* bytes in the burst so far */
+	uint32_t secs, quiet, best_in, best_out;        /* best second, kbit/s */
+} meter;
+
+static void
+net_meter(void)
+{
+	uint64_t now, ns;
+	clock_get_uptime(&now);
+	absolutetime_to_nanoseconds(now, &ns);
+	if (meter.at == 0) {
+		meter.at = ns;
+		meter.in = net_count.received_bytes;
+		meter.out = net_count.sent_bytes;
+		return;
+	}
+	if (ns - meter.at < NSEC_PER_SEC) {
+		return;
+	}
+	uint64_t span = ns - meter.at, din = net_count.received_bytes - meter.in, dout = net_count.sent_bytes - meter.out;
+	uint32_t kin = (uint32_t)(din * 8 * 1000000ull / span), kout = (uint32_t)(dout * 8 * 1000000ull / span);       /* kbit/s */
+	meter.at = ns;
+	meter.in = net_count.received_bytes;
+	meter.out = net_count.sent_bytes;
+	if (kin >= 1000 || kout >= 1000) {
+		meter.secs++;
+		meter.quiet = 0;
+		meter.burst_in += din;
+		meter.burst_out += dout;
+		meter.best_in = MAX(meter.best_in, kin);
+		meter.best_out = MAX(meter.best_out, kout);
+		return;
+	}
+	if (meter.secs != 0 && ++meter.quiet >= 3) {
+		printf("net: %s throughput: %u s busy; in %llu.%llu Mbit/s mean (best second %u.%u), out %llu.%llu Mbit/s mean "
+		    "(best second %u.%u); %llu KB in, %llu KB out\n", net_link->name, meter.secs,
+		    meter.burst_in * 8 / meter.secs / 1000000, meter.burst_in * 8 / meter.secs / 100000 % 10, meter.best_in / 1000,
+		    meter.best_in / 100 % 10, meter.burst_out * 8 / meter.secs / 1000000, meter.burst_out * 8 / meter.secs / 100000 % 10,
+		    meter.best_out / 1000, meter.best_out / 100 % 10, meter.burst_in / 1024, meter.burst_out / 1024);
+		bzero(&meter, sizeof(meter));
+	}
+}
+
 /* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
 static void
 net_thread(__unused void *parameter, __unused wait_result_t result)
 {
-	uint64_t said = 0, total;
+	uint64_t said = 0, total, last_sent = 0;
 	unsigned quiet = 0;
+	uint32_t metered = 1;
 
+	(void)PE_parse_boot_argn("sweetnetmeter", &metered, sizeof(metered));
 	for (unsigned tick = 1;; tick++) {
-		quiet = net_link->poll != NULL && net_link->poll() ? 0 : quiet + 1;
+		unsigned worked = 0;
+		for (unsigned round = 0; round < 4; round++) {
+			unsigned n = net_link->poll != NULL ? net_link->poll() : 0;
+			worked += n;
+			if (n < 16) {
+				break;
+			}
+		}
+		if (worked != 0 || net_count.sent != last_sent) {
+			last_sent = net_count.sent;
+			quiet = 0;
+		} else {
+			quiet++;
+		}
+		if (metered) {
+			net_meter();
+		}
 		/* about once a minute, if anything has moved since */
 		total = net_count.sent + net_count.received + net_count.dropped_out + net_count.dropped_in;
 		if (tick % 8192 == 0 && total != said) {
@@ -285,7 +355,12 @@ net_thread(__unused void *parameter, __unused wait_result_t result)
 			    net_count.sent, net_count.sent_bytes, net_count.received, net_count.received_bytes,
 			    net_count.dropped_out, net_count.dropped_in);
 		}
-		delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
+		/* 250 us while a burst is active (0-2 ms idle transition, 10 ms at rest) */
+		if (quiet < 10) {
+			delay_for_interval(250, NSEC_PER_USEC);
+		} else {
+			delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
+		}
 	}
 }
 
