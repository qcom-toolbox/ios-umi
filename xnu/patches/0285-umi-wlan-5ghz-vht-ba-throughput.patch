+ * 0285: REO commands (ath11k hal_rx.c ath11k_hal_reo_cmd_send / dp_rx.c), the first ones this driver
+ * sends: an entry of the REO command ring = TLV word (tag 9:1, length 25:10) + command header
+ * (number 15:0, set by dp_reo_cmd_init; status wanted 16) + 8 words. The status comes back on the
+ * REO status ring (TLV, then info0: number 15:0, execution status 27:26, 0 = done). Commands:
+ * UPDATE_RX_REO_QUEUE (0x1a3: queue address, update mask, fields, window / SSN) and FLUSH_CACHE
+ * (0x134: address of a 128-byte descriptor, written back and dropped from REO's cache).
+ * 0, EBUSY ring full, ETIMEDOUT no status in 50 ms, EIO status not 0.
+ */
+static int
+wldp_reo_cmd(uint32_t tag, const uint32_t body[8], bool want_status)
+{
+	struct dpring *r = &dp_rings[9], *st = &dp_rings[10];
+	uint32_t size = r->n * r->esz, next = (r->hp + r->esz) % size;
+	if (dp.mem == 0 || next == *mem32(M_RDP + r->id * 4)) {
+		return EBUSY;
+	}
+	volatile uint32_t *d = mem32(r->off + r->hp * 4);
+	uint32_t num = d[1] & 0xffffu;
+	d[0] = tag << 1 | 36u << 10;
+	d[1] = num | (want_status ? 1u << 16 : 0);
+	for (unsigned i = 0; i < 8; i++) {
+		d[2 + i] = body[i];
+	}
+	__builtin_arm_dsb(0xf);
+	r->hp = next;
+	reg_wr(r->r2, r->hp);
+	if (!want_status) {
+		return 0;
+	}
+	uint32_t ssize = st->n * st->esz;
+	for (unsigned t = 0; t < 500; t++) {
+		uint32_t hp = *mem32(M_RDP + st->id * 4);
+		while (st->hp != hp && hp < ssize) {
+			volatile uint32_t *e = mem32(st->off + st->hp * 4);
+			uint32_t info0 = e[1];
+			st->hp = (st->hp + st->esz) % ssize;
+			reg_wr(st->r2 + 4, st->hp);
+			if ((info0 & 0xffffu) == num) {
+				return (info0 >> 26 & 3u) == 0 ? 0 : EIO;
+			}
+		}
+		delay(100);
+	}
+	return ETIMEDOUT;
