From 89cf992571cc4828678d667c963856199be4d03b Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Sun, 15 Nov 2026 22:23:29 +0100
Subject: [PATCH] umi: GPU (0313): the upper levels of the phone's GPU table -
 525 MHz @ 224, 587 MHz @ 256, 670 MHz @ 320 (sweetgpuspeed=4/5/6); the table
 stopped at 490 MHz, which the GPU measured at (0312)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_adreno.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/sweet_adreno.c b/bsd/dev/sweet_adreno.c
index 1b333fe..2906c41 100644
--- a/bsd/dev/sweet_adreno.c
+++ b/bsd/dev/sweet_adreno.c
@@ -1789,10 +1789,12 @@ static bool
 sa_step_core_power(void)
 {
 	/* umi gpu-opp-table_v2 (speed bin 0): 305 MHz @ 64, 400 MHz @ 128, 490 MHz @ 192 (the three lowest the
-	 * phone uses besides 441 @ 144) */
+	 * phone uses besides 441 @ 144); (0313) and its upper levels 525 MHz @ 224, 587 MHz @ 256, 670 MHz @ 320
+	 * (live.dts opp-525000000 / opp-587000000 / opp-670000000) - sweetgpuspeed=4/5/6 */
 	static const struct {
 		uint32_t khz, level;
-	} speeds[] = { { 0, 0 }, { 305000, 64 }, { 400000, 128 }, { 490000, 192 } };
+	} speeds[] = { { 0, 0 }, { 305000, 64 }, { 400000, 128 }, { 490000, 192 }, { 525000, 224 }, { 587000, 256 },
+		{ 670000, 320 } };
 	static struct sa_hfi_perf_table perf;
 	static struct sa_hfi_bw_table bw;
 	uint32_t core_start[2] = { 0, 0 }, start[1] = { 0 }, vote[4] = { 0, 1, 1, 0 }, granted = 0, speed = 1;
-- 
