From 6a1351a5a83dccdffb7ccc0151eb4c837889bc79 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Sat, 14 Nov 2026 12:22:26 +0100
Subject: [PATCH] umi: wlan (0291): link losses (with the reason) and leaves in
 the join history (12 entries); 'wrong password' after a deauth only for
 reasons 2 / 14 / 15 / 23

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 bsd/dev/sweet_wlce.c  | 12 +++++++++---
 bsd/dev/sweet_wlsta.c | 34 +++++++++++++++++++++++++---------
 2 files changed, 34 insertions(+), 12 deletions(-)

diff --git a/bsd/dev/sweet_wlce.c b/bsd/dev/sweet_wlce.c
index f011843..f09e951 100644
--- a/bsd/dev/sweet_wlce.c
+++ b/bsd/dev/sweet_wlce.c
@@ -2179,10 +2179,16 @@ wlce_secure(void)
 		 * away with a deauthentication / disassociation after message 1. Message 1 once and then nothing
 		 * for 8 s (a busy phone at boot, a frame lost) was EAUTH too until now; it is a timeout.
 		 */
-		bool away = htc.lost && (htc.lost_why >> 16 == 0xc0 || htc.lost_why >> 16 == 0xa0);
+		/* 0291: ... and only with a reason that is about the key: 2 (authentication no longer valid), 14 (MIC
+		 * failure), 15 (4-way handshake timeout), 23 (802.1X failed); an AP that sends us away for another
+		 * reason (busy, class errors after its own restart) has not judged the password */
+		uint32_t code = htc.lost_why & 0xffffu;
+		bool away = htc.lost && (htc.lost_why >> 16 == 0xc0 || htc.lost_why >> 16 == 0xa0) &&
+		    (code == 2 || code == 14 || code == 15 || code == 23);
 		bool refused = m1 && (sweet_wlsec_refused() || away);
-		printf("SWEET WMI: 4-way handshake not done (%s, %s%s)\n", htc.joined && !htc.lost ? "8 s" : "the AP sent us away",
-		    m1 ? "message 1 came" : "no message 1 from the AP", refused ? ": the key was turned down" : m1 ? ": a timeout" : "");
+		printf("SWEET WMI: 4-way handshake not done (%s, why %#x, %s%s)\n", htc.joined && !htc.lost ? "8 s" : "the AP sent us away",
+		    htc.lost ? htc.lost_why : 0, m1 ? "message 1 came" : "no message 1 from the AP",
+		    refused ? ": the key was turned down" : m1 ? ": a timeout" : "");
 		return refused ? EAUTH : ETIMEDOUT;
 	}
 	for (t = 0; t < 50; ++t) {      /* (message 4 on the air before the key goes in) */
diff --git a/bsd/dev/sweet_wlsta.c b/bsd/dev/sweet_wlsta.c
index 890839e..977148a 100644
--- a/bsd/dev/sweet_wlsta.c
+++ b/bsd/dev/sweet_wlsta.c
@@ -161,18 +161,24 @@ sta_note_joined(void)
  */
 static struct {
 	uint32_t at_s;
-	uint8_t key;                    /* 0 open, 1 passphrase, 2 PMK */
+	uint8_t key;                    /* 0 open, 1 passphrase, 2 PMK; 0291: 3 the link was lost, 4 left when asked */
 	int16_t result;
-} sta_hist[8];
+	uint32_t why;                   /* lost: frame subtype << 16 | reason code, or event << 8 | reason */
+} sta_hist[12];
 static unsigned sta_hist_n;
 
 static void
 sta_hist_say(void)
 {
-	for (unsigned i = sta_hist_n > 8 ? sta_hist_n - 8 : 0; i < sta_hist_n; i++) {
-		printf("SWEET WLSTA: join %u at %u s after boot: %s -> %d\n", i + 1, sta_hist[i % 8].at_s,
-		    sta_hist[i % 8].key == 0 ? "no key (open)" : sta_hist[i % 8].key == 1 ? "passphrase as typed" : "key from wifid (PMK)",
-		    sta_hist[i % 8].result);
+	for (unsigned i = sta_hist_n > 12 ? sta_hist_n - 12 : 0; i < sta_hist_n; i++) {
+		if (sta_hist[i % 12].key >= 3) {
+			printf("SWEET WLSTA: event %u at %u s after boot: %s (%#x)\n", i + 1, sta_hist[i % 12].at_s,
+			    sta_hist[i % 12].key == 3 ? "the link was LOST" : "left when asked (wifid / Settings)", sta_hist[i % 12].why);
+			continue;
+		}
+		printf("SWEET WLSTA: join %u at %u s after boot: %s -> %d\n", i + 1, sta_hist[i % 12].at_s,
+		    sta_hist[i % 12].key == 0 ? "no key (open)" : sta_hist[i % 12].key == 1 ? "passphrase as typed" : "key from wifid (PMK)",
+		    sta_hist[i % 12].result);
 	}
 }
 
@@ -230,9 +236,9 @@ sta_join(const struct redwood_sta_join *what)
 	bzero(pmk, sizeof(pmk));
 	sta_last_error = r;
 	printf("SWEET WLSTA: join (a name of %u bytes, %s) -> %d\n", what->ssid_length, key ? "WPA2" : "open", r);
-	sta_hist[sta_hist_n % 8].at_s = (uint32_t)(sta_now_ms() / 1000);
-	sta_hist[sta_hist_n % 8].key = key == NULL ? 0 : what->passphrase_length != 0 ? 1 : 2;
-	sta_hist[sta_hist_n % 8].result = (int16_t)r;
+	sta_hist[sta_hist_n % 12].at_s = (uint32_t)(sta_now_ms() / 1000);
+	sta_hist[sta_hist_n % 12].key = key == NULL ? 0 : what->passphrase_length != 0 ? 1 : 2;
+	sta_hist[sta_hist_n % 12].result = (int16_t)r;
 	sta_hist_n++;
 	sta_hist_say();
 	if (r == 0) {
@@ -248,6 +254,12 @@ sta_join(const struct redwood_sta_join *what)
 static int
 sta_leave(void)
 {
+	if (sweet_wlce_joined(NULL)) {
+		sta_hist[sta_hist_n % 12].at_s = (uint32_t)(sta_now_ms() / 1000);
+		sta_hist[sta_hist_n % 12].key = 4;
+		sta_hist[sta_hist_n % 12].why = 0;
+		sta_hist_n++;
+	}
 	sweet_wlce_lock(true);
 	(void)sweet_wlce_leave();
 	sweet_wlce_lock(false);
@@ -385,6 +397,10 @@ sta_poll(void)
 	}
 	sweet_wlce_lock(false);
 	if (lost != 0) {
+		sta_hist[sta_hist_n % 12].at_s = (uint32_t)(sta_now_ms() / 1000);
+		sta_hist[sta_hist_n % 12].key = 3;
+		sta_hist[sta_hist_n % 12].why = lost;
+		sta_hist_n++;
 		printf("SWEET WLSTA: the link is lost (%#x)\n", lost);
 		sta_last_error = ECONNRESET;
 		redwood_net_link_state(false);
-- 
